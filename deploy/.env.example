# Copy to .env on the server and fill in. Never commit the real .env.

# Your domain (its DNS A record must point at the server's IP).
DOMAIN=play.example.com
# A long random password, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me

# Image to run (published by GitHub Actions on every merge to main).
IMAGE=ghcr.io/tony-27/ludo-brawl
TAG=latest

# Gameplay timings (seconds).
LUDO_TURN_TIMEOUT=30
LUDO_BOT_DELAY=1.1

# How many days of nightly database backups to keep in ./backups.
BACKUP_KEEP_DAYS=14
