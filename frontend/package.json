{
  "name": "ludo-brawl-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "gen:protocol": "json2ts -i protocol.schema.json -o src/app/core/protocol.ts --no-additionalProperties --unreachableDefinitions --bannerComment \"/* Generated from backend/app/realtime/protocol.py by npm run gen:protocol. Do not edit. */\""
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@babylonjs/core": "^9.38.0",
    "@babylonjs/loaders": "^9.38.0",
    "@babylonjs/materials": "^9.38.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@babylonjs/inspector": "^9.38.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
